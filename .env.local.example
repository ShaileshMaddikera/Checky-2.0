# Bright Data API Key - get from https://brightdata.com user settings
BRIGHTDATA_API_KEY=your_brightdata_api_key_here

# Anthropic API Key - for Claude Vision OCR (primary OCR engine)
# Get from https://console.anthropic.com/
# Falls back to Tesseract.js if not set
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Moss.dev (optional - for product search caching, v2)
MOSS_API_KEY=your_moss_api_key_here
MOSS_INDEX_ID=your_moss_index_id_here
