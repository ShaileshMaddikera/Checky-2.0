# ── LiveKit Cloud ─────────────────────────────────────────────────────────────
# Create a free account at https://cloud.livekit.io → Your Project → Settings → Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# Public var — safe to expose to browser (only the WS URL, not the secret)
NEXT_PUBLIC_LIVEKIT_URL=wss://your-project.livekit.cloud

# ── Bright Data ───────────────────────────────────────────────────────────────
# Amazon product search API. Get from brightdata.com → User Settings
BRIGHTDATA_API_KEY=your_brightdata_api_key_here

# ── Moss.dev ──────────────────────────────────────────────────────────────────
# Semantic product search cache. Get from moss.dev → Your Project
MOSS_PROJECT_ID=your_moss_project_id_here
MOSS_PROJECT_KEY=your_moss_project_key_here
