# ── LiveKit ───────────────────────────────────────────────────────────────────
# Get from: https://cloud.livekit.io → Your Project → Settings → Keys
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=APIxxxxxxxxxxxxxxx
LIVEKIT_API_SECRET=your_livekit_api_secret_here

# ── Gemini / Google AI Studio ─────────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
# NOTE: must be named GOOGLE_API_KEY (not GEMINI_API_KEY)
GOOGLE_API_KEY=your_google_ai_studio_api_key_here

# ── Moss.dev ──────────────────────────────────────────────────────────────────
# Get from: https://moss.dev → Your Project → Settings
MOSS_PROJECT_ID=your_moss_project_id_here
MOSS_PROJECT_KEY=your_moss_project_key_here

# ── Bright Data ───────────────────────────────────────────────────────────────
# API key: brightdata.com → User Settings → API → API Token
BRIGHTDATA_API_KEY=your_brightdata_api_key_here

# Web Scraper Studio collector IDs (c_...)
# Get from: brightdata.com/cp/scrapers → open your scraper → "API" tab
# Add these in agent/tools.py SCRAPERS dict if you create scrapers
# BRIGHTDATA_AMAZON_COLLECTOR=c_your_amazon_collector_id
# BRIGHTDATA_WALMART_COLLECTOR=c_your_walmart_collector_id

# Dataset marketplace IDs (gd_...) — already configured in tools.py DATASETS dict
# Get from: brightdata.com/cp/datasets → open your dataset → "API" tab
# The Amazon one (gd_l7q7dkf244hwjntr0) is pre-configured
